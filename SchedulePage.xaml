<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WasteTracker.SchedulePage"
    Title="Schedule Pickup"
    BackgroundColor="#F7FAF8">

    <ScrollView>

        <VerticalStackLayout
            Padding="18"
            Spacing="16">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*">

                <Button
                    Text="‹"
                    Clicked="Back_Clicked"
                    BackgroundColor="Transparent"
                    TextColor="#17221B"
                    FontSize="34"
                    Padding="0"
                    WidthRequest="40" />

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">

                    <Label
                        Text="Schedule Pickup"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#17221B" />

                    <Label
                        Text="Choose when you want your waste collected."
                        FontSize="11"
                        TextColor="#718078" />

                </VerticalStackLayout>

            </Grid>


            <!-- Date -->
            <Border
                BackgroundColor="White"
                Stroke="#E0E8E3"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="16">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="📅  PICKUP DATE"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#527060" />

                    <DatePicker
                        x:Name="PickupDatePicker"
                        FontSize="16"
                        TextColor="#17221B" />

                </VerticalStackLayout>

            </Border>


            <!-- Time -->
            <Border
                BackgroundColor="White"
                Stroke="#E0E8E3"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="16">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="🕘  TIME SLOT"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#527060" />

                    <Picker
                        x:Name="TimeSlotPicker"
                        Title="Choose a time slot"
                        FontSize="15"
                        TextColor="#17221B" />

                </VerticalStackLayout>

            </Border>


            <!-- Summary -->
            <Border
                BackgroundColor="#E7F4EB"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                Padding="16">

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Pickup Summary"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#1F5D38" />

                    <Label
                        x:Name="SummaryLabel"
                        Text="Choose a date and time slot."
                        FontSize="13"
                        TextColor="#527060" />

                </VerticalStackLayout>

            </Border>


            <Button
                Text="✓  Confirm Pickup"
                Clicked="OnConfirmScheduleClicked"
                HeightRequest="52"
                CornerRadius="17"
                BackgroundColor="#2E7D4F"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="15" />


            <Label
                Text="You can review your scheduled pickup from the Home and Track pages."
                FontSize="11"
                TextColor="#8A9690"
                HorizontalTextAlignment="Center"
                Margin="10,0" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>