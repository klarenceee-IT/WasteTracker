
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WasteTracker.HomePage"
    Title="Home"
    BackgroundColor="#F7FAF8">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="18">

            <!-- ORIGINAL HEADER -->

            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout Spacing="3">

                    <Label
                        Text="WasteTracker"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#2E7D4F" />

                    <Label
                        x:Name="WelcomeUserLabel"
                        Text="Welcome, User!"
                        FontSize="25"
                        FontAttributes="Bold"
                        TextColor="#17221B" />

                    <Label
                        Text="Let's keep our environment clean."
                        FontSize="13"
                        TextColor="#718078" />

                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    WidthRequest="48"
                    HeightRequest="48"
                    BackgroundColor="#E5F3EA"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24">

                    <Label
                        Text="♻"
                        FontSize="25"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                </Border>

            </Grid>

            <!-- ORIGINAL MONTHLY WASTE CARD -->

            <Border
                BackgroundColor="#2E7D4F"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22"
                Padding="20">

                <Grid
                    RowDefinitions="Auto,Auto,Auto"
                    ColumnDefinitions="*,Auto">

                    <Label
                        Text="TOTAL WASTE COLLECTED"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#D9F0E1" />

                    <Label
                        Grid.Row="1"
                        x:Name="Total"
                        Text="0 kg"
                        FontSize="36"
                        FontAttributes="Bold"
                        TextColor="White"
                        Margin="0,4,0,0" />

                    <Label
                        Grid.Row="2"
                        Text="This month"
                        FontSize="12"
                        TextColor="#CFE8D8" />

                    <Border
                        Grid.Column="1"
                        Grid.RowSpan="3"
                        WidthRequest="55"
                        HeightRequest="55"
                        BackgroundColor="#FFFFFF"
                        Opacity="0.18"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 28">

                        <Label
                            Text="♻"
                            FontSize="30"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>

                </Grid>

            </Border>
            <!-- ORIGINAL QUICK ACTIONS -->

            <VerticalStackLayout Spacing="10">

                <Label
                    Text="Quick Actions"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#17221B" />

                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="10"
                    RowSpacing="10">

                    <!-- SCHEDULE -->

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E0E8E3"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14">

                        <VerticalStackLayout Spacing="7">

                            <Label Text="📅" FontSize="25" />

                            <Label
                                Text="Schedule"
                                FontAttributes="Bold"
                                TextColor="#17221B" />

                            <Label
                                Text="Book a pickup"
                                FontSize="11"
                                TextColor="#718078" />

                        </VerticalStackLayout>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="Schedule_Tapped" />
                        </Border.GestureRecognizers>

                    </Border>

                    <!-- TRACK -->

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E0E8E3"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14">

                        <VerticalStackLayout Spacing="7">

                            <Label Text="🚚" FontSize="25" />

                            <Label
                                Text="Track"
                                FontAttributes="Bold"
                                TextColor="#17221B" />

                            <Label
                                Text="View pickup"
                                FontSize="11"
                                TextColor="#718078" />

                        </VerticalStackLayout>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="Track_Tapped" />
                        </Border.GestureRecognizers>

                    </Border>

                    <!-- DROP-OFF MAP -->

                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E0E8E3"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14">

                        <VerticalStackLayout Spacing="7">

                            <Label Text="📍" FontSize="25" />

                            <Label
                                Text="Drop-off Map"
                                FontAttributes="Bold"
                                TextColor="#17221B" />

                            <Label
                                Text="Find locations"
                                FontSize="11"
                                TextColor="#718078" />

                        </VerticalStackLayout>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="Map_Tapped" />
                        </Border.GestureRecognizers>

                    </Border>

                    <!-- WASTE GUIDE -->

                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E0E8E3"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14">

                        <VerticalStackLayout Spacing="7">

                            <Label Text="📚" FontSize="25" />

                            <Label
                                Text="Waste Guide"
                                FontAttributes="Bold"
                                TextColor="#17221B" />

                            <Label
                                Text="Learn to sort"
                                FontSize="11"
                                TextColor="#718078" />

                        </VerticalStackLayout>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="Guide_Tapped" />
                        </Border.GestureRecognizers>

                    </Border>

                </Grid>

            </VerticalStackLayout>

            
            <!-- WASTE CATEGORIES HEADER -->

            <Grid ColumnDefinitions="*,Auto">

                <Label
                    Text="Waste Categories"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#17221B" />

                <Label
                    Grid.Column="1"
                    Text="See all"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="#2E7D4F"
                    VerticalOptions="Center">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="SeeAll_Tapped" />
                    </Label.GestureRecognizers>

                </Label>

            </Grid>

            <!-- WASTE CATEGORY CARDS -->

            <FlexLayout
                x:Name="Cats"
                Direction="Row"
                Wrap="Wrap"
                JustifyContent="SpaceBetween"
                AlignItems="Start"
                AlignContent="Start">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>

                        <Border
                            FlexLayout.Basis="48%"
                            BackgroundColor="#FFA2E5B6"
                            Stroke="#D8E8DC"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="12"
                            Margin="0,0,0,10">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="{Binding Icon}"
                                    FontSize="28"
                                    HorizontalOptions="Center" />

                                <Label
                                    Text="{Binding Name}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#17221B"
                                    HorizontalOptions="Center" />

                            </VerticalStackLayout>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="Cat_Tapped" />
                            </Border.GestureRecognizers>

                        </Border>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </FlexLayout>


            <Border
                BackgroundColor="White"
                Stroke="#E0E8E3"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="16">

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="12">

                    <Border
                        WidthRequest="45"
                        HeightRequest="45"
                        BackgroundColor="#E7F4EB"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14">

                        <Label
                            Text="🚚"
                            FontSize="22"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Spacing="3">

                        <Label
                            Text="Next Collection"
                            FontSize="12"
                            TextColor="#718078" />

                        <Label
                            x:Name="NextL"
                            Text="Nothing scheduled yet"
                            FontAttributes="Bold"
                            FontSize="14"
                            TextColor="#17221B" />

                    </VerticalStackLayout>

                    <Label
                        Grid.Column="2"
                        Text="›"
                        FontSize="28"
                        TextColor="#2E7D4F"
                        VerticalOptions="Center" />

                </Grid>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="Next_Tapped" />
                </Border.GestureRecognizers>

            </Border>

            <BoxView
                HeightRequest="15"
                Color="Transparent" />



        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
