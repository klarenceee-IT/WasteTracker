<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WasteTracker.HistoryPage"
    Title="History"
    BackgroundColor="#F7FAF8">

    <Grid
        RowDefinitions="Auto,Auto,Auto,*"
        Padding="18"
        RowSpacing="14">

        <Grid ColumnDefinitions="*,Auto">

            <VerticalStackLayout Spacing="2">

                <Label
                    Text="Waste History"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="#17221B" />

                <Label
                    Text="Review your recycling activity"
                    FontSize="12"
                    TextColor="#718078" />

            </VerticalStackLayout>

            <Label
                Grid.Column="1"
                Text="♻"
                FontSize="27"
                TextColor="#2E7D4F"
                VerticalOptions="Center" />

        </Grid>


        <!-- Summary -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*"
            ColumnSpacing="10">

            <Border
                BackgroundColor="White"
                Stroke="#E0E8E3"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                Padding="14">

                <VerticalStackLayout Spacing="3">

                    <Label
                        Text="Records"
                        FontSize="11"
                        TextColor="#718078" />

                    <Label
                        x:Name="RecordCountLabel"
                        Text="0"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#17221B" />

                </VerticalStackLayout>

            </Border>


            <Border
                Grid.Column="1"
                BackgroundColor="#E7F4EB"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18"
                Padding="14">

                <VerticalStackLayout Spacing="3">

                    <Label
                        Text="Total Weight"
                        FontSize="11"
                        TextColor="#527060" />

                    <Label
                        x:Name="TotalWeightLabel"
                        Text="0 kg"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#2E7D4F" />

                </VerticalStackLayout>

            </Border>

        </Grid>


        <!-- Filters -->
        <ScrollView
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalScrollBarVisibility="Never">

            <HorizontalStackLayout
                x:Name="Chips"
                Spacing="8">

                <Button
                    Text="All"
                    Clicked="Chip_Clicked"
                    HeightRequest="38"
                    CornerRadius="19"
                    Padding="18,0"
                    BackgroundColor="#2E7D4F"
                    TextColor="White" />

                <Button
                    Text="This Month"
                    Clicked="Chip_Clicked"
                    HeightRequest="38"
                    CornerRadius="19"
                    Padding="18,0"
                    BackgroundColor="#E5ECE8"
                    TextColor="#385145" />

                <Button
                    Text="Older"
                    Clicked="Chip_Clicked"
                    HeightRequest="38"
                    CornerRadius="19"
                    Padding="18,0"
                    BackgroundColor="#E5ECE8"
                    TextColor="#385145" />

            </HorizontalStackLayout>

        </ScrollView>


        <!-- History List -->
        <CollectionView
            x:Name="List"
            Grid.Row="3"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="8">

                    <Label
                        Text="📋"
                        FontSize="45"
                        HorizontalOptions="Center" />

                    <Label
                        Text="No history yet"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#17221B"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Your waste records will appear here."
                        FontSize="12"
                        TextColor="#718078"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>


            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        BackgroundColor="White"
                        Stroke="#E0E8E3"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="13"
                        Margin="0,0,0,9">

                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="12">

                            <Border
                                WidthRequest="48"
                                HeightRequest="48"
                                BackgroundColor="{Binding TintColor}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 15">

                                <Label
                                    Text="{Binding Icon}"
                                    FontSize="23"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="3">

                                <Label
                                    Text="{Binding Category}"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    TextColor="#17221B" />

                                <Label
                                    Text="{Binding Sub}"
                                    FontSize="11"
                                    TextColor="#718078" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Text="{Binding KgText}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#2E7D4F"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>