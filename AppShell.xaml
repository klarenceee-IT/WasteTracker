
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WasteTracker"
    x:Class="WasteTracker.AppShell"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="#2E7D4F"
    Shell.TabBarTitleColor="#2E7D4F"
    Shell.TabBarUnselectedColor="#8A9690">

    <TabBar>

        <!-- HOME -->
        <Tab Title="Home" Icon="Resources/Images/home.png">
            <ShellContent
                Title="Home"
                Route="HomePage"
                ContentTemplate="{DataTemplate local:HomePage}" />
        </Tab>

        <!-- MAP -->
        <Tab Title="Map" Icon="Resources/Images/map.png">
            <ShellContent
                Title="Map"
                Route="MapPage"
                ContentTemplate="{DataTemplate local:MapPage}" />
        </Tab>

        <!-- CATEGORIES -->
        <Tab Title="Categories" Icon="Resources/Images/category.png">
            <ShellContent
                Title="Categories"
                Route="CategoriesPage"
                ContentTemplate="{DataTemplate local:CategoriesPage}" />
        </Tab>

        <!-- HISTORY -->
        <Tab Title="History" Icon="Resources/Images/history.png">
            <ShellContent
                Title="History"
                Route="HistoryPage"
                ContentTemplate="{DataTemplate local:HistoryPage}" />
        </Tab>

        <!-- PROFILE -->
        <Tab Title="Profile" Icon="Resources/Images/user.png">
            <ShellContent
                Title="Profile"
                Route="ProfilePage"
                ContentTemplate="{DataTemplate local:ProfilePage}" />
        </Tab>

    </TabBar>

</Shell>
