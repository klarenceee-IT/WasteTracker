<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
    x:Class="WasteTracker.MapPage"
    Title="Eco Drop-off Map"
    BackgroundColor="#F7FAF8">

    <Grid>

        <!-- Real Google/MAUI Map -->
        <maps:Map
            x:Name="EcoMap"
            MapType="Street"
            IsShowingUser="True" />


        <!-- Top information card -->
        <Border
            HorizontalOptions="Center"
            VerticalOptions="Start"
            Margin="18"
            BackgroundColor="White"
            Stroke="#E0E8E3"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 18"
            Padding="16">

            <VerticalStackLayout
                Spacing="3"
                HorizontalOptions="Center">

                <Label
                    Text="📍 Eco Drop-off Map"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#17221B"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Find recycling and waste drop-off locations"
                    FontSize="11"
                    TextColor="#718078"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </Border>


        <!-- Bottom controls -->
        <VerticalStackLayout
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="18"
            Spacing="10">

            <Button
                Text="◎"
                Clicked="OnCenterLocationClicked"
                WidthRequest="52"
                HeightRequest="52"
                CornerRadius="26"
                BackgroundColor="White"
                TextColor="#2E7D4F"
                FontSize="25"
                Padding="0" />

            <Button
                Text="Back"
                Clicked="OnBackClicked"
                HeightRequest="45"
                CornerRadius="15"
                BackgroundColor="#2E7D4F"
                TextColor="White"
                FontAttributes="Bold"
                Padding="18,0" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>