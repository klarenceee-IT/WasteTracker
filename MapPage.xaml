<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="WasteTracker.MapPage" BackgroundColor="White">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="10">
        <Label Text="Drop Off Locations" Style="{StaticResource H1}" />
        <VerticalStackLayout Grid.Row="1" Spacing="6">
            <SearchBar x:Name="Search" Placeholder="Search location..." TextChanged="Search_Changed" />
            <HorizontalStackLayout x:Name="Chips" Spacing="6">
                <Button Text="All" Clicked="Chip_Clicked" HeightRequest="34" FontSize="12" Padding="14,0" />
                <Button Text="Recycling Center" Clicked="Chip_Clicked" HeightRequest="34" FontSize="12" Padding="14,0" />
                <Button Text="TPS" Clicked="Chip_Clicked" HeightRequest="34" FontSize="12" Padding="14,0" />
                <Button Text="E-Waste" Clicked="Chip_Clicked" HeightRequest="34" FontSize="12" Padding="14,0" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <GraphicsView x:Name="MapView" Grid.Row="2" StartInteraction="Map_Touch" />
        <Border x:Name="Card" Grid.Row="3" Style="{StaticResource Card}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label x:Name="NameL" FontAttributes="Bold" /><Label x:Name="InfoL" Style="{StaticResource Sub}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Get Directions" Style="{StaticResource Cta}" HeightRequest="42" FontSize="13" Clicked="Directions_Clicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
