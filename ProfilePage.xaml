<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WasteTracker.ProfilePage"
    Title="Profile"
    BackgroundColor="#F7FAF8"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="18"
            Spacing="18">

            <Label
                Text="My Profile"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#17221B" />


            <!-- Profile Header -->
            <Border
                BackgroundColor="White"
                Stroke="#E0E8E3"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="18">

                <VerticalStackLayout
                    Spacing="8"
                    HorizontalOptions="Center">

                    <Border
                        WidthRequest="80"
                        HeightRequest="80"
                        BackgroundColor="#E7F4EB"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 40">

                        <Label
                            x:Name="Initials"
                            Text="U"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="#2E7D4F"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>

                    <Label
                        x:Name="NameL"
                        Text="User"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="#17221B"
                        HorizontalTextAlignment="Center" />

                    <Label
                        x:Name="EmailL"
                        Text="user@wastetracker.com"
                        FontSize="12"
                        TextColor="#718078"
                        HorizontalTextAlignment="Center" />

                    <Label
                        x:Name="ProfileUsernameLabel"
                        FontSize="11"
                        TextColor="#9AA7A0"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Border>


            <!-- Green Points -->
            <Border
                BackgroundColor="#2E7D4F"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22"
                Padding="18">

                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Spacing="3">

                        <Label
                            Text="🌱 Green Points"
                            TextColor="White"
                            FontSize="15"
                            FontAttributes="Bold" />

                        <Label
                            Text="Keep recycling to earn more rewards."
                            TextColor="#CFE8D8"
                            FontSize="11" />

                    </VerticalStackLayout>

                    <Label
                        x:Name="PointsL"
                        Grid.Column="1"
                        Text="120 pts"
                        TextColor="White"
                        FontSize="23"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />

                </Grid>

            </Border>


            <Label
                Text="Account"
                FontSize="17"
                FontAttributes="Bold"
                TextColor="#17221B" />


            <!-- Menu -->
            <VerticalStackLayout
                x:Name="Menu"
                Spacing="9" />


            <!-- Logout -->
            <Button
                Text="Log Out"
                BackgroundColor="#FDECEC"
                TextColor="#C0392B"
                CornerRadius="16"
                HeightRequest="50"
                FontAttributes="Bold"
                Clicked="Logout_Clicked"
                Margin="0,5,0,20" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>