<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WasteTracker.CategoriesPage"
    Title="Categories"
    BackgroundColor="#F7FAF8">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="18"
          RowSpacing="14">

        <!-- Header -->
        <Grid ColumnDefinitions="Auto,*,Auto">

            <Button
                Text="‹"
                Clicked="Back_Clicked"
                BackgroundColor="Transparent"
                TextColor="#17221B"
                FontSize="34"
                Padding="0"
                WidthRequest="40" />

            <Label
                Grid.Column="1"
                Text="Waste Categories"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="#17221B"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center" />

            <Label
                Grid.Column="2"
                Text="♻"
                FontSize="24"
                TextColor="#2E7D4F"
                VerticalOptions="Center" />

        </Grid>


        <!-- Description -->
        <Border
            Grid.Row="1"
            BackgroundColor="#E7F4EB"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 18"
            Padding="15">

            <VerticalStackLayout Spacing="4">

                <Label
                    Text="Sort your waste correctly"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="#1F5D38" />

                <Label
                    Text="Tap a category to record your waste contribution."
                    FontSize="12"
                    TextColor="#527060" />

            </VerticalStackLayout>

        </Border>


        <!-- List -->
        <CollectionView
            x:Name="List"
            Grid.Row="2"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="8">

                    <Label
                        Text="♻"
                        FontSize="42"
                        HorizontalOptions="Center" />

                    <Label
                        Text="No waste categories available"
                        FontAttributes="Bold"
                        TextColor="#17221B"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Your categories will appear here."
                        FontSize="12"
                        TextColor="#718078"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>


            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        BackgroundColor="White"
                        Stroke="#E0E8E3"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14"
                        Margin="0,0,0,10">

                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="13">

                            <Border
                                WidthRequest="50"
                                HeightRequest="50"
                                BackgroundColor="{Binding TintColor}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">

                                <Label
                                    Text="{Binding Icon}"
                                    FontSize="25"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="3">

                                <Label
                                    Text="{Binding Name}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#17221B" />

                                <Label
                                    Text="{Binding Desc}"
                                    FontSize="12"
                                    TextColor="#718078" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Text="›"
                                FontSize="28"
                                TextColor="#2E7D4F"
                                VerticalOptions="Center" />

                        </Grid>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnCategoryTapped" />
                        </Border.GestureRecognizers>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>


        <Border
            Grid.Row="3"
            BackgroundColor="White"
            Stroke="#E0E8E3"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 18"
            Padding="14">

            <Label
                Text="🌱 Every properly sorted item helps reduce waste and supports a cleaner environment."
                FontSize="12"
                TextColor="#527060" />

        </Border>

    </Grid>

</ContentPage>